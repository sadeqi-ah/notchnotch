{
  "name": "notchnotch",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:extensions && pnpm build:native && node scripts/package-app.mjs",
    "build:extensions": "node scripts/build-extensions.mjs",
    "build:native": "swift build --cache-path .build/cache",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm build:extensions && swift test --cache-path .build/cache && node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm build:native"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.34.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-reconciler": "0.34.0"
  }
}
