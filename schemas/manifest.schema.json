{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotchNotch extension manifest v1 preview",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "entry",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "apiVersion": {
      "const": 1
    },
    "entry": {
      "const": "bundle.js"
    },
    "permissions": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local-network",
          "process"
        ]
      }
    },
    "connections": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/connection"
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    }
  },
  "additionalProperties": false,
  "$defs": {
    "connection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint"
          ],
          "properties": {
            "transport": {
              "const": "http"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^https?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint"
          ],
          "properties": {
            "transport": {
              "const": "websocket"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^wss?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+(/[^?#]*)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "executable"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "arguments": {
              "type": "array",
              "maxItems": 22,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
